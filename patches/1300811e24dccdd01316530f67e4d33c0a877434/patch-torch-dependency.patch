+    # Discover CCCL (libcu++) for cuda/std/* headers required by NVSHMEM
+    # In CUDA 13+, CCCL headers moved to ${CUDA_HOME}/include/cccl/
+    cccl_include_dir = None
+    cuda_home = os.environ.get('CUDA_HOME', '/usr/local/cuda')
+    # Check new CUDA 13+ location first, then fall back to legacy location
+    for cccl_subdir in ['include/cccl', 'include']:
+        candidate = os.path.join(cuda_home, cccl_subdir)
+        if os.path.exists(os.path.join(candidate, 'cuda', 'std', 'tuple')):
+            cccl_include_dir = candidate
+            print(f'Found CCCL at: {cccl_include_dir}')
+            break
+
