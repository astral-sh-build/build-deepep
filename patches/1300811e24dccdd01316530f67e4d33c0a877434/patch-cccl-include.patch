diff --git a/setup.py b/setup.py
index e89a9db..1234567 100644
--- a/setup.py
+++ b/setup.py
@@ -31,6 +31,14 @@ if __name__ == '__main__':
     if not disable_nvshmem:
         assert os.path.exists(nvshmem_dir), f'The specified NVSHMEM directory does not exist: {nvshmem_dir}'

+    # Discover CCCL (libcu++) for cuda/std/* headers required by NVSHMEM
+    # CCCL is installed alongside NVSHMEM in the nvidia namespace
+    cccl_include_dir = None
+    if nvshmem_dir:
+        cccl_include_dir = os.path.join(os.path.dirname(nvshmem_dir), 'cuda_cccl', 'include')
+        if os.path.exists(cccl_include_dir):
+            print(f'Found CCCL at: {cccl_include_dir}')
+
     cxx_flags = ['-O3', '-Wno-deprecated-declarations', '-Wno-unused-variable', '-Wno-sign-compare', '-Wno-reorder', '-Wno-attributes']
     nvcc_flags = ['-O3', '-Xcompiler', '-O3']
     sources = ['csrc/deep_ep.cpp', 'csrc/kernels/runtime.cu', 'csrc/kernels/layout.cu', 'csrc/kernels/intranode.cu']
@@ -48,6 +56,10 @@ if __name__ == '__main__':
         nvcc_dlink.extend(['-dlink', f'-L{nvshmem_dir}/lib', '-lnvshmem_device'])
         extra_link_args.extend([f'-l:{nvshmem_host_lib}', '-l:libnvshmem_device.a', f'-Wl,-rpath,{nvshmem_dir}/lib'])

+    # Add CCCL include path if found (needed for cuda/std/* headers)
+    if cccl_include_dir and os.path.exists(cccl_include_dir):
+        include_dirs.append(cccl_include_dir)
+
     if int(os.getenv('DISABLE_SM90_FEATURES', 0)):
         # Prefer A100
         os.environ['TORCH_CUDA_ARCH_LIST'] = os.getenv('TORCH_CUDA_ARCH_LIST', '8.0')
